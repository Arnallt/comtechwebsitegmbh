{
  "name": "comtech-gmbh-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run check:tk",
    "build:preview": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:tk": "node scripts/check-tk.mjs",
    "lint:prose": "vale src/content && node scripts/check-prose.mjs",
